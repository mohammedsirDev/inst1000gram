# Backend Environment Variables (Private & Server-only)
DJANGO_SECRET_KEY=django-insecure-inst1000gram-production-core-engine-key-xyz!99
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# CORS settings for Next.js frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.insta1000gram.com

# Downloader Engine Limits
MAX_DOWNLOAD_RETRIES=3
DOWNLOAD_PROXY_TIMEOUT_MS=15000

# Security (Never expose to frontend/browser)
SITE_DOMAIN=https://www.insta1000gram.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=inst1000gram-super-secret-session-auth
